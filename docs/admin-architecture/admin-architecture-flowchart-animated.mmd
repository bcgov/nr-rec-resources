flowchart TD
  subgraph Container[" "]
    direction TB
    classDef container fill:#f5f5f5,stroke:#bdbdbd,stroke-width:4px
    class Container container;
    subgraph subGraph0["Admin Frontend"]
      UI["Admin UI"]
      UI@{ icon: "azure:users", pos: "b" }
    end
    subgraph subGraphAssets["Frontend Assets (CDN)"]
      S3["AWS S3"]
      S3@{ icon: "aws:simple-storage-service", pos: "b" }
      CFAssets["CloudFront CDN (Assets)"]
      CFAssets@{ icon: "aws:cloudfront", pos: "b" }
    end
    subgraph subGraphStorage["S3 Storage"]
      StorageCDN["CloudFront CDN (Storage)"]
      StorageCDN@{ icon: "aws:cloudfront", pos: "b" }
      ImagesS3["S3 (Images)"]
      ImagesS3@{ icon: "aws:simple-storage-service", pos: "b" }
      DocsS3["S3 (Documents)"]
      DocsS3@{ icon: "aws:simple-storage-service", pos: "b" }
    end
    subgraph subGraph1["Admin Backend"]
      APICDN["API CDN"]
      APICDN@{ icon: "aws:cloudfront", pos: "b" }
      ALB["App Load Balancer"]
      ALB@{ icon: "aws:elastic-load-balancing", pos: "b" }
      Gateway["API Gateway"]
      Gateway@{ icon: "aws:api-gateway", pos: "b" }
      API["Admin API"]
      API@{ icon: "aws:fargate", pos: "b" }
    end
    subgraph Database["Database"]
      DB[("AWS Aurora PostgreSQL<br>PostGIS")]
      DB@{ icon: "aws:aurora", pos: "b" }
    end
    subgraph subGraph4["External Services"]
      KeycloakExt["BcGov SSO"]
      KeycloakExt@{ icon: "azure:multifactor-authentication", pos: "b" }
      ACTExt["ACT"]
      ACTExt@{ icon: "mdi:cloud-outline", pos: "b" }
      BCGWExt["BCGW"]
      BCGWExt@{ icon: "mdi:cloud-outline", pos: "b" }
      ForestClientExt["Forest Client API"]
      ForestClientExt@{ icon: "mdi:cloud-outline", pos: "b" }
      FTAMigration["Flyway Migration"]
    end
    KeycloakExt ~~~ ForestClientExt
    ForestClientExt ~~~ FTAMigration
    UI e1@-->|"SSO Auth"| KeycloakExt
    UI e2@-->|"API Call"| APICDN
    APICDN e5@-->|"API Routing"| Gateway
    Gateway e6@-->|"Load Balancing"| ALB
    ALB e7@--> API
    API e13@-->|"DB Query"| DB
    API e14@---->|"Auth / User Info"| KeycloakExt
    ACTExt e15@-->|"Inbound advisory CUD API\n/api/v1/act/advisories"| APICDN
    BCGWExt e23@-->|"Outbound GeoJSON pull\n/api/v1/bcgw/*"| APICDN
    API e25@-->|"Partner/client lookups\n/api/clients/findByClientNumber/{clientNumber}\n/api/clients/{clientNumber}/locations"| ForestClientExt
    FTAMigration e26@-->|"FTA import / sync"| DB
    API e24@-->|"ACT writes + BCGW export reads"| DB
    UI e16@-->|"Asset Fetch"| CFAssets
    CFAssets e17@-->|"Asset Origin"| S3
    UI e18@-->|"File Read"| StorageCDN
    StorageCDN e19@-->|"CDN Origin"| ImagesS3
    StorageCDN e20@-->|"CDN Origin"| DocsS3
    UI e21@-->|"Direct Upload"| ImagesS3
    UI e22@-->|"Direct Upload"| DocsS3
    UI:::frontend
    API:::backend
    DB:::database
    APICDN:::aws
    ALB:::aws
    Gateway:::aws
    KeycloakExt:::external
    ACTExt:::external
    BCGWExt:::external
    ForestClientExt:::external
    FTAMigration:::external
    S3:::aws
    CFAssets:::aws
    StorageCDN:::aws
    ImagesS3:::aws
    DocsS3:::aws
  end

  class Container container;
  e1@{ animation: fast }
  e2@{ animation: fast }
  e5@{ animation: slow }
