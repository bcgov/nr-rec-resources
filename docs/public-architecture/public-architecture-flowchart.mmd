flowchart TD
  subgraph Container[" "]
    direction TB
    classDef container fill:#f5f5f5,stroke:#bdbdbd,stroke-width:4px
      classDef container fill:#f5f5f5,stroke:#bdbdbd,stroke-width:4px
      classDef frontend fill:#1f78b4,stroke:#155a8a,color:#000000
      classDef neutral fill:#f5f5f5,stroke:#bdbdbd,color:#000000
      classDef storage fill:#7aa116,stroke:#4d6810,color:#000000
      classDef api fill:#8c4fff,stroke:#5e35b1,color:#000000
      classDef database fill:#c925d1,stroke:#741579,color:#000000
      classDef external fill:#6b6b6b,stroke:#444444,color:#000000


    subgraph Frontend["Public Frontend"]
      UI["Public UI"]
      UI@{ icon: "azure:users", pos: "b" }
    end

    subgraph FrontendAssets["Frontend Assets (CDN)"]
      FrontendBucket["S3"]
      FrontendBucket@{ icon: "aws:simple-storage-service", pos: "b" }
      FrontendCDN["CloudFront CDN (Assets)"]
      FrontendCDN@{ icon: "aws:cloudfront", pos: "b" }
    end

    subgraph FileStorage["S3 Storage"]
      StorageCDN["CloudFront CDN (Storage)"]
      StorageCDN@{ icon: "aws:cloudfront", pos: "b" }
      ImagesBucket["S3 (Images)"]
      ImagesBucket@{ icon: "aws:simple-storage-service", pos: "b" }
      DocumentsBucket["S3 (Documents)"]
      DocumentsBucket@{ icon: "aws:simple-storage-service", pos: "b" }
    end

    subgraph PublicAPI["Public Backend"]
      APICDN["API CDN"]
      APICDN@{ icon: "aws:cloudfront", pos: "b" }
      APIGateway["API Gateway"]
      APIGateway@{ icon: "aws:api-gateway", pos: "b" }
      ALB["App Load Balancer"]
      ALB@{ icon: "aws:elastic-load-balancing", pos: "b" }
      API["Public API"]
      API@{ icon: "aws:fargate", pos: "b" }
    end

    subgraph Database["Database"]
      DB[("AWS Aurora PostgreSQL<br>PostGIS")]
      DB@{ icon: "aws:aurora", pos: "b" }
    end

    subgraph ExternalServices["External Services"]
      ForestAPI["FSA Forest Client API"]
      ForestAPI@{ icon: "mdi:cloud-outline", pos: "b" }
      FTAMigration["Flyway Migration"]
    end

    ForestAPI ~~~ FTAMigration

    UI e1@-->|"Asset Fetch"| FrontendCDN
    FrontendCDN e2@-->|"Asset Origin"| FrontendBucket
    UI e3@-->|"File Read"| StorageCDN
    StorageCDN e4@-->|"CDN origin"| ImagesBucket
    StorageCDN e5@-->|"CDN origin"| DocumentsBucket
    UI e6@-->|"API Call"| APICDN
    APICDN e7@-->|"API routing"| APIGateway
    APIGateway e8@-->|"VPC link"| ALB
    ALB e9@--> API
    API e10@-->|"DB query"| DB
    API e11@-->|"Client lookup / search"| ForestAPI
    FTAMigration e12@-->|"FTA import / sync"| DB

    UI:::neutral
    FrontendBucket:::neutral
    FrontendCDN:::storage
    StorageCDN:::storage
    ImagesBucket:::storage
    DocumentsBucket:::storage
    APICDN:::api
    APIGateway:::api
    ALB:::api
    API:::api
    DB:::database
    ForestAPI:::external
    FTAMigration:::external
  end

  class Container container;
  e1@{ animation: fast }
  e2@{ animation: fast }
  e3@{ animation: fast }
  e4@{ animation: slow }
  e5@{ animation: slow }
  e6@{ animation: fast }
  e7@{ animation: slow }
  e8@{ animation: slow }
  e9@{ animation: slow }
  e10@{ animation: fast }
  e11@{ animation: fast }
  e12@{ animation: fast }
