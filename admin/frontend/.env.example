# Keycloak (OIDC) configuration
VITE_KEYCLOAK_AUTH_SERVER_URL=<auth-url>
VITE_KEYCLOAK_REALM=standard
VITE_KEYCLOAK_CLIENT_ID=<client-id>
BACKEND_URL=<admin-backend-url>
VITE_RECREATION_RESOURCE_ASSETS_BASE_URL=<assets-url>
VITE_STAFF_ADMIN_URL=<act-tool-url>
HAPPO_API_KEY=
HAPPO_API_SECRET=
HAPPO_PROJECT=rst-admin

# E2E test credentials (admin-only; local docker-compose uses e2e-admin from realm-export)
E2E_BASE_URL=http://localhost:3001
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=TestPass1!

# Deployed (dev/test) runs against the real BC Gov Keycloak set E2E_TARGET=deployed.
# These are configured as GitHub environment secrets, not committed.
# E2E_TARGET=deployed
# E2E_ADMIN_USERNAME=<dedicated test IDIR account>
# E2E_ADMIN_PASSWORD=<idir account password>
# E2E_ADMIN_TOTP_SECRET=<plain-text TOTP secret captured at MFA enrollment>  # consumed by the otplib MFA flow
